# Copy to .env and fill in. The bot reads .env with python-dotenv at startup.
TELEGRAM_TOKEN=
NEWSAPI_KEY=
GNEWS_API_KEY=
CLAUDE_API_KEY=
PYTHONUNBUFFERED=1
export AWS_BEARER_TOKEN_BEDROCK=
export AWS_BEDROCK_REGION=us-east-1
export AWS_BEDROCK_INFERENCE_PROFILE_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional: Unsplash fallback photos for stories whose own image is missing or too small.
# Without it the magazine falls back to the bundled AI images in templates/images.
UNSPLASH_ACCESS_KEY=
